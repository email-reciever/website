{
  "name": "@email.reciever/monorepo",
  "description": "Email subscription → parser worker → GitHub content → TanStack Start website",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "corepack pnpm -F=\"@email.reciever/website\" dev",
    "build": "corepack pnpm -F=\"@email.reciever/website\" build",
    "deploy": "corepack pnpm -F=\"@email.reciever/website\" deploy",
    "check": "biome check .",
    "format": "biome check --write .",
    "migrate": "node scripts/migrate-content.mjs",
    "parser:dev": "corepack pnpm -F=\"@email.reciever/parser\" dev",
    "parser:deploy": "corepack pnpm -F=\"@email.reciever/parser\" deploy",
    "parser:test": "corepack pnpm -F=\"@email.reciever/parser\" test",
    "sr": "corepack pnpm -F=\"@email.reciever/server\" dev",
    "build:td": "corepack pnpm -F=\"@email.reciever/turndown\" build",
    "dev:td": "corepack pnpm -F=\"@email.reciever/turndown\" dev",
    "postinstall": "corepack pnpm run build:td"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.7",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  },
  "licenses": [
    {
      "type": "MIT"
    }
  ],
  "author": {
    "name": "innocces",
    "email": "jiangjiangjiangxi@gmail.com"
  },
  "repository": {
    "type": "github",
    "url": "https://github.com/email-reciever/website",
    "branch": "main"
  }
}
