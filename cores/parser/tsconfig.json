{
  "compilerOptions": {
    "target": "es2022",
    // DOM included for the HTML node casts used by the turndown fork / cheerio
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "es2022",
    "moduleResolution": "Bundler",
    "types": ["./worker-configuration.d.ts", "node"],
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["test"],
  "include": ["worker-configuration.d.ts", "env.d.ts", "src/**/*.ts"]
}
